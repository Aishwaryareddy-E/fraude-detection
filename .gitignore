# Virtual Environment
venv/
ENV/
env/
.venv/

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Large Data files (Keep git repo lightweight and compatible with GitHub file limits)
*.csv
data/raw/*.csv
*.zip

# Full processed data (too large for GitHub) — only samples are tracked
data/processed/fraud_data.parquet
data/processed/creditcard.parquet

# Processed intermediate data (can be regenerated or tracked via git-lfs if needed)
# Keep placeholder .gitkeep in directories
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/reports/.gitkeep

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Streamlit logs/cache (but NOT config.toml — that's needed for cloud deployment)
.streamlit/secrets.toml
.streamlit/*.log
